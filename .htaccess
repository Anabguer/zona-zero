DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /juegos/zona-zero/
</IfModule>

# Evitar caché agresiva de módulos ES sin ?v= (Hostalia/nginx puede sobrescribir).
# La fuente de verdad del bust es ZZ_ASSET_V + importmap en index.php/play.php.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(webmanifest)$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
        Header set Content-Type "application/manifest+json"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
